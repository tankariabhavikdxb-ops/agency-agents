# ═══════════════════════════════════════════════════════════════════════════
# Tally Bridge configuration
#
# Copy this file to `.env` (setup does this automatically) and adjust.
# Every value is optional — the defaults below work for Tally Prime 2.1
# running on the SAME PC with the standard port.
# Real environment variables always win over values in this file.
# ═══════════════════════════════════════════════════════════════════════════

# ── Web server ────────────────────────────────────────────────────────────
# 127.0.0.1 = only this PC can open the interface
# 0.0.0.0   = anyone on the LAN can open it (phones, other desktops)
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=5000
# BRIDGE_DEBUG=False

# ── Tally Prime connection ────────────────────────────────────────────────
# Use the PC name/IP when Tally runs on another machine of your LAN,
# e.g. TALLY_HOST=192.168.1.10
TALLY_HOST=localhost
TALLY_PORT=9000
# TALLY_URL=http://localhost:9000        # overrides host/port entirely

# ── ODBC (optional fast read path) ────────────────────────────────────────
# The DSN Tally Prime creates on Windows; or provide a full connection
# string instead:
# TALLY_ODBC_DSN=TallyODBC64_9000
# TALLY_ODBC_CONNECT_STRING=Driver={Tally ODBC Driver};Server=localhost;Port=9000

# ── Sync & performance tuning ─────────────────────────────────────────────
# SYNC_INTERVAL=5        # seconds between Tally change checks
# REQUEST_TIMEOUT=30     # seconds per request to Tally
# CACHE_TTL=15           # seconds a read response stays cached
# MAX_CONCURRENT=5       # max parallel requests forwarded to Tally
# MAX_BATCH=100          # records per ODBC fetch batch
# MAX_CACHE_MB=50        # response-cache memory budget
